<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_MAX_SIZE" value="100000"/>
    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/substance_service4.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- daily rollover -->
            <fileNamePattern>${LOG_DIR}/substance_service.%d{yyyy-MM-dd}.gz</fileNamePattern>
            <!-- keep 30 days' worth of history capped at 3GB total size -->
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-4relative [%thread] %-5level %logger{35} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="ROOT" level="WARN" >
        <appender-ref ref="ROLLING_FILE" />
    </logger>
    <logger name="gov.nih.ncats.molwitch.renderer" level="TRACE" >
        <appender-ref ref="ROLLING_FILE" />
    </logger>

</configuration>